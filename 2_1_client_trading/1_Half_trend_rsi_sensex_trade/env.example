# Dhan client id from web.dhan.co -> My Profile -> Access DhanHQ APIs.
# Paste the id after the equals sign. Do not add quotes.
DHAN_CLIENT_ID=

# Dhan access token from the same API page.
# This is a secret. Do not commit a real token or share it.
# Order placement also needs a static IP whitelisted on Dhan.
# Quotes, candles, and the option chain need an active Dhan Data Plan.
DHAN_ACCESS_TOKEN=
